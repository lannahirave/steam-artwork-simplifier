{
  "name": "web",
  "private": true,
  "version": "1.2.36",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:beta": "tsc -b && vite build --mode beta",
    "deploy": "npm run build && npx wrangler deploy",
    "deploy:beta": "npm run build:beta && npx wrangler deploy --env beta",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "bench:workshop": "node ./scripts/benchmark-workshop.mjs",
    "bench:memory": "node ./scripts/benchmark-memory.mjs",
    "bench:memory:cleanup": "node ./scripts/benchmark-memory.mjs --scenario smoke --summary-only --assert-frame-cache-cleared",
    "release:beta": "node scripts/deploy.mjs beta",
    "release:prod": "node scripts/deploy.mjs prod"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "gifski-wasm": "^2.2.0",
    "jszip": "^3.10.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-intl": "^10.2.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.91.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.11",
    "wrangler": "^4.157.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.30.1"
    }
  }
}
