{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "react-perf", "jsx-a11y", "import", "promise", "vitest"],
  "env": { "browser": true, "es2024": true },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "react/react-in-jsx-scope": "off"
  },
  "overrides": [
    {
      "files": ["scripts/**", "e2e/**", "*.config.ts", "cloudflare/**", "bridge/**"],
      "env": { "node": true }
    }
  ],
  "ignorePatterns": ["dist/**", "public/vendor/**", "test-results/**", "playwright-report/**", ".impeccable/**", ".wrangler/**"]
}
